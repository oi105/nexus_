# GEMINI_API_KEY: Required for server-side NEXUS AI Insight & Difficulty Reward Assessment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Cloudinary configuration for external media CDN hosting.
# When omitted (or invalid), NEXUS automatically uses built-in local media storage (/api/uploads/direct).
# Signed upload (recommended when using Cloudinary):
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or unsigned upload preset fallback:
CLOUDINARY_UPLOAD_PRESET=""

